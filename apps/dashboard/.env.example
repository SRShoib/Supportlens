# Base URL the dashboard's server-side pages fetch apps/api from. Never
# exposed to the browser -- every fetch in src/lib/api.ts runs in a Server
# Component, so there's no CORS surface to configure on the API side.
#
# Local `pnpm dev` (API running on the host): http://localhost:8000
# Inside docker-compose (see infra/docker-compose.yml): http://api:8000
API_BASE_URL=http://localhost:8000
