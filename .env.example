# Postgres
POSTGRES_USER=supportlens
POSTGRES_PASSWORD=supportlens
POSTGRES_DB=supportlens
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://supportlens:supportlens@localhost:5432/supportlens

# Chroma
CHROMA_HOST=localhost
CHROMA_PORT=8001
# Leave unset for local dev/docker-compose (networked chroma service above
# is used instead). Set only on a host with no persistent disk for a
# separate chroma service (e.g. Render's free web services) -- switches
# ml/inference/vector_store.py to an on-disk chromadb.PersistentClient at
# this path instead, rebuilt on every boot by RUN_DEMO_SEED_ON_BOOT below.
CHROMA_EMBEDDED_PATH=

# API
API_PORT=8000
ENV=dev
LOG_LEVEL=INFO
# Leave unset for local dev (data is seeded once via `make demo`/`make
# seed`, not on every restart). Set to true only on a free-tier host with
# no persistent disk, so infra/api-entrypoint.sh re-runs the idempotent
# demo seed (data/seed/*.jsonl -> Postgres, no-op after the first boot) and
# always rebuilds the Chroma index (see CHROMA_EMBEDDED_PATH above) on
# every container start.
RUN_DEMO_SEED_ON_BOOT=false

# Dashboard
DASHBOARD_PORT=3000

# Data
DATA_DIR=./data
TWCS_CSV_PATH=./data/raw/twcs/twcs.csv
HF_HOME=./data/raw/hf
RANDOM_SEED=42
SLICE_TARGET_MESSAGES=150000
SLICE_MAX_BRAND_SHARE=0.08
LANG_CONFIDENCE_THRESHOLD=0.70

# LLM — unused until M2; guard defaults to off
OPENAI_API_KEY=
LLM_BUDGET_USD=5.00
LLM_ENABLED=false
RAG_MAX_COMPLETION_TOKENS=400
