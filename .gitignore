# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
.venv/
venv/
.python-version

# Test / lint / type caches
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# Data & models (raw downloads, artifacts — never committed)
data/raw/*
data/interim/*
data/splits/*
data/embeddings/*
data/eval/*
!data/raw/.gitkeep
!data/interim/.gitkeep
!data/splits/.gitkeep
!data/embeddings/.gitkeep
!data/eval/.gitkeep
models/*
!models/.gitkeep
# M10: the classical baselines are tiny (<4MB each, no GPU/training-group
# needed to reproduce) and are what the zero-setup demo serves live by
# default (docs/decisions.md) -- committed so `make demo` needs no external
# model host. Every transformer export (the opt-in, GPU-trained path) stays
# gitignored.
!models/baseline_intent_v1
!models/baseline_intent_v1/model.joblib
!models/baseline_urgency_v1
!models/baseline_urgency_v1/model.joblib
!models/baseline_sentiment_v1
!models/baseline_sentiment_v1/model.joblib
!models/baseline_emotion_v1
!models/baseline_emotion_v1/model.joblib
.chroma/

# Env / secrets
.env
.env.*
!.env.example

# Node (dashboard, later modules)
node_modules/

# Editor / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Alembic-generated local artifacts
*.sqlite3
